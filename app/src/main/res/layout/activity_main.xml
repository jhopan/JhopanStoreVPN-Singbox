<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="JhopanStore VPN" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Address / Target Server"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:hint="example.com:443"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="#222222"
                android:padding="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="UUID"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/uuid"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:hint="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="#222222"
                android:padding="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Path"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/path"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:hint="/vless"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="#222222"
                android:padding="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SNI (Server Name Indication)"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/sni"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:hint="example.com"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="#222222"
                android:padding="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Header Host"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/host"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:hint="example.com"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="#222222"
                android:padding="8dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="CONNECT"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/traffic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="#2196F3"
                android:text="Traffic: -" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:padding="12dp"
                android:background="#1A1A1A"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:lineSpacingExtra="4dp"
                android:text="Disconnected" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
